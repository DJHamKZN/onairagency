# Локальный прототип. Только безопасные заглушки — реальных секретов здесь нет и быть не должно.
# Скопируйте в .env и при необходимости поменяйте значения.

# Порт и адрес. Сервер намеренно слушает только локальный интерфейс.
PORT=5174
HOST=127.0.0.1

# Путь к файлу SQLite (создаётся автоматически, каталог в .gitignore).
DB_PATH=./data/crm.sqlite

# Пароль для синтетических тестовых учётных записей (владелец, PM и т.д.).
# Если не задан, при первом наполнении базы генерируется случайный пароль и печатается в консоль.
DEMO_USER_PASSWORD=change-me-local-only

# Необязательно: путь к TTF-шрифту с кириллицей для серверной генерации PDF.
# Если не задан, ищутся Arial / Liberation Sans / DejaVu Sans в системных каталогах.
PDF_FONT_PATH=

# Интеграции НЕ подключены. Переменные ниже не читаются кодом и приведены только как список будущих решений.
# AI_PROVIDER_API_KEY=
# MAIL_SMTP_URL=
# DRIVE_SERVICE_ACCOUNT=
# ESIGN_API_KEY=
# PAYMENTS_API_KEY=
